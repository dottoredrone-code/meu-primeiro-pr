# Copie para .env e preencha só as chaves que tiver.
# Provedor sem chave é pulado automaticamente na cadeia de fallback.

# Texto
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=            # id do modelo Claude (veja docs.anthropic.com)
GEMINI_API_KEY=          # também usada para imagens (Nano Banana)
OPENAI_API_KEY=          # também usada para imagens e voz
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=         # ex.: http://localhost:11434/v1

# Busca na web
TAVILY_API_KEY=
BRAVE_API_KEY=

# Imagem e vídeo
FAL_KEY=
CLOUDFLARE_ACCOUNT_ID=   # grátis: 10.000 neurons/dia de FLUX schnell (~170 imagens), uso comercial (K36)
CLOUDFLARE_API_TOKEN=    # token com permissão "Workers AI" (painel da Cloudflare)

# Mídia gratuita (fotos, vídeos e sons de banco, com licença por arquivo)
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=       # só projetos não comerciais (D22)

# Voz
ELEVENLABS_API_KEY=
